{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "gamevault-app",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-07",
  "workers_dev": true,
  "assets": {
    "directory": ".cloudflare-public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/media/covers/*"]
  },
  "d1_databases": []
}
